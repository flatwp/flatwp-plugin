{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "flatwp/icon-text",
  "version": "1.0.0",
  "title": "Icon Text",
  "category": "flatwp",
  "icon": "align-left",
  "description": "Content section with icon or image and text",
  "keywords": [
    "icon",
    "text",
    "image",
    "content"
  ],
  "textdomain": "flatwp",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "anchor": true,
    "className": true
  },
  "attributes": {
    "mediaType": {
      "type": "string",
      "default": "icon",
      "enum": [
        "icon",
        "image"
      ]
    },
    "icon": {
      "type": "string",
      "default": "star"
    },
    "imageId": {
      "type": "number"
    },
    "imageUrl": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "buttonText": {
      "type": "string",
      "default": ""
    },
    "buttonUrl": {
      "type": "string",
      "default": ""
    },
    "layout": {
      "type": "string",
      "default": "horizontal",
      "enum": [
        "horizontal",
        "horizontal-reverse",
        "vertical",
        "vertical-centered"
      ]
    },
    "mediaSize": {
      "type": "string",
      "default": "medium",
      "enum": [
        "small",
        "medium",
        "large",
        "xlarge"
      ]
    },
    "colorScheme": {
      "type": "string",
      "default": "light",
      "enum": [
        "light",
        "dark",
        "transparent"
      ]
    },
    "iconStyle": {
      "type": "string",
      "default": "filled",
      "enum": [
        "filled",
        "outlined",
        "minimal"
      ]
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}