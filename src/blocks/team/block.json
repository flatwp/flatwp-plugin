{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "flatwp/team",
  "version": "1.0.0",
  "title": "Team Section",
  "category": "flatwp",
  "icon": "groups",
  "description": "Display team members in a grid layout.",
  "keywords": [
    "team",
    "members",
    "staff",
    "people",
    "about"
  ],
  "textdomain": "flatwp",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Meet Our Team"
    },
    "columns": {
      "type": "string",
      "default": "3",
      "enum": [
        "2",
        "3",
        "4"
      ]
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "className": true,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "allowedBlocks": [
    "flatwp/team-member"
  ],
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}