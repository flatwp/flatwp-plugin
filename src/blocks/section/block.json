{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "flatwp/section",
  "version": "1.0.0",
  "title": "Section",
  "category": "flatwp",
  "icon": "layout",
  "description": "A flexible section wrapper with background options and spacing controls",
  "keywords": ["section", "container", "wrapper", "layout"],
  "textdomain": "flatwp",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "anchor": true,
    "className": true
  },
  "attributes": {
    "colorScheme": {
      "type": "string",
      "default": "transparent",
      "enum": ["light", "dark", "primary", "gradient", "transparent"]
    },
    "backgroundType": {
      "type": "string",
      "default": "color",
      "enum": ["color", "gradient", "image"]
    },
    "backgroundImageUrl": {
      "type": "string"
    },
    "backgroundImageId": {
      "type": "number"
    },
    "overlayOpacity": {
      "type": "number",
      "default": 50
    },
    "gradientFrom": {
      "type": "string",
      "default": "#2563eb"
    },
    "gradientTo": {
      "type": "string",
      "default": "#7c3aed"
    },
    "gradientDirection": {
      "type": "string",
      "default": "to-br",
      "enum": ["to-r", "to-l", "to-b", "to-t", "to-br", "to-bl", "to-tr", "to-tl"]
    },
    "paddingTop": {
      "type": "string",
      "default": "large",
      "enum": ["none", "small", "medium", "large", "xlarge"]
    },
    "paddingBottom": {
      "type": "string",
      "default": "large",
      "enum": ["none", "small", "medium", "large", "xlarge"]
    },
    "containerWidth": {
      "type": "string",
      "default": "default",
      "enum": ["narrow", "default", "wide", "full"]
    },
    "dividerTop": {
      "type": "string",
      "default": "none",
      "enum": ["none", "wave", "curve", "triangle", "slant"]
    },
    "dividerBottom": {
      "type": "string",
      "default": "none",
      "enum": ["none", "wave", "curve", "triangle", "slant"]
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css"
}
