{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "flatwp/logo-row",
  "version": "1.0.0",
  "title": "Logo Row",
  "category": "flatwp",
  "icon": "images-alt2",
  "description": "Display partner or client logos with optional grayscale effect.",
  "keywords": [
    "logos",
    "partners",
    "clients",
    "brands",
    "trusted"
  ],
  "textdomain": "flatwp",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Trusted by industry leaders"
    },
    "logos": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object"
      }
    },
    "displayMode": {
      "type": "string",
      "default": "grayscale-hover",
      "enum": [
        "color",
        "grayscale",
        "grayscale-hover"
      ]
    },
    "columns": {
      "type": "number",
      "default": 5
    },
    "logoSize": {
      "type": "string",
      "default": "medium",
      "enum": [
        "small",
        "medium",
        "large"
      ]
    },
    "alignment": {
      "type": "string",
      "default": "center"
    },
    "colorScheme": {
      "type": "string",
      "default": "light",
      "enum": [
        "light",
        "dark",
        "transparent"
      ]
    },
    "showHeading": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "className": true,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}